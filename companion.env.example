# Zorofin companion module settings. Copy to companion.env and fill in what you
# use; leave the rest commented. Keys and tokens are better as files in the
# secrets folder (NAME_FILE=/run/zorofin/<file>) than as values here.
# Every variable is described in README.md.

# Shown in emails and alerts.
#ZOROFIN_SERVER_NAME=Zorofin
#ZOROFIN_APP_URL=https://jellyfin.example.com

# notifications: email and/or ntfy.
#ZOROFIN_NOTIFY_EMAIL_FROM=Zorofin <alerts@example.com>
#ZOROFIN_NOTIFY_EMAIL_REPLY_TO=
#ZOROFIN_NOTIFY_EMAIL_API_KEY_FILE=/run/zorofin/email-api-key
#ZOROFIN_NOTIFY_NTFY_URL=http://ntfy:80
#ZOROFIN_NOTIFY_NTFY_PUBLIC_URL=https://ntfy.example.com
#ZOROFIN_NOTIFY_NTFY_TOKEN_FILE=/run/zorofin/ntfy-publish-token
#ZOROFIN_NOTIFY_NTFY_ADMIN_TOKEN_FILE=/run/zorofin/ntfy-admin-token

# liveTvGuide: an XMLTV guide to improve (for example Threadfin's).
#ZOROFIN_GUIDE_SOURCE_URL=http://threadfin:34400/xmltv/threadfin.xml
#ZOROFIN_GUIDE_TOKEN_FILE=/run/zorofin/guide-token

# liveTvStreams: how many different channels can play at once (match Threadfin's tuner count).
# Add the provider's Xtream login to read its real limit and spot streams used elsewhere.
#ZOROFIN_STREAMS_LIMIT=1
#ZOROFIN_STREAMS_XTREAM_URL=http://provider.example:8080
#ZOROFIN_STREAMS_XTREAM_USERNAME=
#ZOROFIN_STREAMS_XTREAM_PASSWORD_FILE=/run/zorofin/xtream-password

# recommendations: optional AI ranking with your own key (anthropic, openai or off).
#ZOROFIN_RECOMMENDATIONS_AI=off
#ZOROFIN_RECOMMENDATIONS_AI_KEY_FILE=/run/zorofin/ai-key
